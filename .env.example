SANNYGOLD_ENV=local
SANNYGOLD_SECRET_KEY=
SANNYGOLD_ADMIN_EMAIL=contato@sannygold.com
SANNYGOLD_ADMIN_PASSWORD=troque-esta-senha
SANNYGOLD_ADMIN_NAME=Administrador SannyGold
ROTAFLOW_STORAGE_DIR=./data-local
SANNYGOLD_SQLITE_PATH=./data/sannygold.db
SANNYGOLD_STORAGE_BACKEND=sqlite
SANNYGOLD_SQLITE_MIRROR_JSON=1
DROPBOX_BACKUP_DIR=/Users/thiago/Dropbox/Sistema SannyGold/Backups
SANNYGOLD_TAILSCALE_URL=
SANNYGOLD_TAILSCALE_IP=
PORT=5007
FLASK_HOST=0.0.0.0
FLASK_DEBUG=0
SANNYGOLD_SESSION_COOKIE_SECURE=0

# Para preencher SANNYGOLD_SECRET_KEY, gere uma chave unica:
# openssl rand -hex 32

# Opcional para acesso externo privado via Tailscale:
# use SANNYGOLD_TAILSCALE_URL=http://100.x.y.z:5007/
# ou SANNYGOLD_TAILSCALE_IP=100.x.y.z para o sistema montar a URL com a porta atual.

# Opcional para o launcher local:
# PORT define a porta aberta no computador.
# FLASK_HOST=0.0.0.0 permite acesso pelo celular no mesmo Wi-Fi.
# FLASK_HOST=127.0.0.1 permite acesso apenas no proprio computador.

# Opcional. Use apenas em testes controlados se precisar desativar CSRF temporariamente.
SANNYGOLD_CSRF_DISABLED=0
